{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/lib/**/*.js",
